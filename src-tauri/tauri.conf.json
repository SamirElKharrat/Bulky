{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulky",
  "version": "0.2.0",
  "identifier": "app.bulksort.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Bulky", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Organiza tu bulk de Riftbound",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Bulky"
      },
      "wix": {
        "language": "es-ES",
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp"
      }
    }
  }
}
